// Conversation Model

// A conversation is a end-to-end chat between exactly two users

model Conversation {
  id String @id @default(uuid())

  listingId String
  listing   Listing @relation(fields: [listingId], references: [id])

  buyerId String
  buyer   User   @relation("BuyerConversations", fields: [buyerId], references: [id])

  sellerId String
  seller   User   @relation("SellerConversations", fields: [sellerId], references: [id])

  messages Message[]

  messageSequence Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([listingId, buyerId, sellerId])
}
